    "@types/react-dom": "19.0.3",
    "@types/three": "0.172.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^29.1.1",
    "postcss": "8.5.23",
